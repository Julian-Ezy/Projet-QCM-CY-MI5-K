#include <stdio.h>

void fonction_etudiant() {
}

void fonction_enseignant() {
int choix;
    printf("Que voulez-vous faire ?\n");
    printf("1. Créer un QCM\n");
    printf("2. Changer le mot de passe\n");
    printf("Vous choisissez \"1\" ou \"2\" ? : ");
    scanf("%d", &choix);
    if (choix == 1) {
        fonction_etudiant();
    } else if (choix == 2) {
        enseignant_mdp();
    } else {
        printf("Choix invalide. Veuillez choisir \"1\" ou \"2\".\n");
    }
}

void enseignant_mdp() {
    int mdp;
    do{     
    printf("Rentrez le mot de passe pour pouvoir continuer:\n");
    scanf("%d", &mdp);
    if (mdp == 182426) {
        fonction_enseignant();
    } else {
        printf("Mot de passe incorrect.\n");
    }
    } while (mdp != 182426);
}


void choix_utilisateur() {
    int choix;

    printf("Choisissez une option :\n");
    printf("1. Acceder au mode etudiant\n");
    printf("2. Acceder au mode enseignant\n");
    printf("3. Quitter\n");
    do{
        printf("Vous choisissez \"1\" , \"2\" ou \"3\" ? : ");
        scanf("%d", &choix);
        if (choix == 1) {
            fonction_etudiant();
        } else if (choix == 2) {
            enseignant_mdp();
        } else if (choix == 3) {
            printf("Au revoir !\n");
            break;
        } else {
           printf("Choix invalide. Veuillez choisir \"1\" , \"2\" ou \"3\".\n");
        }
    } while (choix != 1 && choix != 2 && choix != 3);
}

int main() {

    choix_utilisateur();
    return 0;
}