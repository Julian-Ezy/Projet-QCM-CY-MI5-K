void enseignant_mdp() {
    int rep;
    do{     
    printf("Rentrez le mot de passe pour pouvoir continuer:\n");
    printf("Ou bien taper 0 pour revenir en arriere:\n");
    scanf("%d", &rep);
    if (rep == 182426) {
